---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry, MarkdownHeading } from 'astro:content';
import { SITE, CATEGORIES, CATEGORY_ORDER, clusterOf, isPublicCategory } from '@lib/site';
import AdSlot from '@components/AdSlot.astro';
import ArticleCard from '@components/ArticleCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TableOfContents from '@components/TableOfContents.astro';
import { articleSlug, articleHref } from '@lib/article';
import { pickImage } from '@lib/images';
import HeroCard from '@components/HeroCard.astro';

export interface Props {
  article: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
  readingMinutes: number;
}

const { article, headings, readingMinutes } = Astro.props;
const { data } = article;
const cat = CATEGORIES[data.category];

const dateStr = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.pubDate);

// 의료 글의 "최종 검토일" 표기용. schema 의 lastReviewed 와 같은 날짜를 화면에도 노출한다
// (검토 시점이 보이지 않으면 감수 표기가 장식으로만 읽힌다).
const reviewedDate = data.updatedDate ?? data.pubDate;
const reviewedDateStr = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(reviewedDate);

const all = await getCollection('articles', ({ data }) => !data.draft);

// 관련 글: 같은 카테고리 안에서 태그 overlap 점수 desc, 동점은 최신순. random 제거 — 빌드마다
// 다른 글이 노출되면 Google 이 일관성을 못 잡고, 진짜 관련 있는 글이 노출 안 됨. 결정적 정렬로
// 진짜 관련 글이 SERP 시그널·dwell time 양쪽 강화.
const articleTagSet = new Set(data.tags);
const related = all
  .filter((a) => a.slug !== article.slug && a.data.category === data.category)
  .map((a) => ({
    a,
    score: a.data.tags.filter((t) => articleTagSet.has(t)).length,
  }))
  .sort((x, y) => {
    if (y.score !== x.score) return y.score - x.score;
    return y.a.data.pubDate.valueOf() - x.a.data.pubDate.valueOf();
  })
  .slice(0, 6)
  .map((x) => x.a);

// 더 둘러보기 — 🚨 같은 주제 군집 안에서만 뽑는다.
// 예전에는 전 카테고리에서 뽑아서, 건강 글 사이드바에 자동차·여행 링크가 걸렸다.
// 그러면 크롤러가 그 글의 주제를 건강으로 좁히지 못하고 사이트 정체성이 흐려진다.
// (글을 지우지 않고 '섞임'만 끊는 조치. clusterOf 정의는 site.ts 참조.)
const myCluster = clusterOf(data.category);
const moreCandidates = CATEGORY_ORDER.filter(
  (c) => c !== data.category && clusterOf(c) === myCluster
);
const more = (
  moreCandidates.length > 0
    ? // 군집 안에 다른 카테고리가 있으면 카테고리별 최신 1편씩
      moreCandidates
        .map((cat) =>
          all
            .filter((a) => a.slug !== article.slug && a.data.category === cat)
            .sort((x, y) => y.data.pubDate.valueOf() - x.data.pubDate.valueOf())[0]
        )
        .filter(Boolean)
    : // 의료 군집처럼 카테고리가 하나뿐이면 같은 카테고리의 다른 최신 글로 채운다
      all
        .filter(
          (a) =>
            a.slug !== article.slug &&
            a.data.category === data.category &&
            !related.some((r) => r.slug === a.slug)
        )
        .sort((x, y) => y.data.pubDate.valueOf() - x.data.pubDate.valueOf())
).slice(0, 4);

const mainUrl = new URL(Astro.url.pathname, SITE.url).toString();
const logoUrl = new URL('/favicon.svg', SITE.url).toString();
// 편집 데스크(Organization) 페이지 — 글의 author(=편집부) 가 가리킨다.
const deskUrl = new URL('/author/healthpick-team/', SITE.url).toString();
// 실명 감수자(Person) 프로필 — editor / reviewedBy 가 가리킨다.
// 🚨 YMYL 신호는 Person 을 조직 페이지가 아니라 개인 프로필로 연결해야 살아난다.
const authorUrl = new URL('/author/sung-juhyun/', SITE.url).toString();
const orgPublisher = {
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: logoUrl },
};

// 헬스픽 = YMYL 건강 도메인. 의료 = MedicalWebPage, 그 외 = Article.
// 주의: NewsArticle 자동 분기는 제거 (2026-06-12).
// 이유 — 기존 정규식이 "2026", "시행", "신규" 같은 흔한 단어를 hit 해 정책·세무·시행 글
// 거의 전부를 NewsArticle 로 마크. Google 의 News Publisher Center 등록 없이 NewsArticle
// 을 광범위하게 사용하면 misleading structured data 정책 위반으로 색인 제거 위험.
// GSC impression 0 사고(2026-06-12) 직전 commit(8f9942b, 6/3)이 도입한 분기.
const articleTypes = [
  data.medical && 'MedicalWebPage',
  'Article',
].filter(Boolean);
// 한국어 분당 평균 읽기 속도 약 250자 → readingMinutes × 250 = 본문 글자수 추정
// schema.org wordCount = "단어 수"이지만 한국어는 글자수 기반 추정으로 갈음.
const wordCountEstimate = Math.max(1000, Math.round(readingMinutes * 250));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': articleTypes.length === 1 ? articleTypes[0] : articleTypes,
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: data.author,
    url: deskUrl,
  },
  // 편집 총괄 — 실명 편집장(성주현). 모든 글에 표기.
  // worksFor 는 진료 소속(MedicalClinic)으로 연결한다. 운영 법인이 아니라 임상 소속이
  // YMYL 에서 검증 가능한 앵커이기 때문.
  editor: {
    '@type': 'Person',
    name: SITE.editor.name,
    jobTitle: SITE.editor.specialty,
    url: authorUrl,
    // 개원 전에는 worksFor 를 넣지 않는다 (아직 진료하지 않는 소속을 선언하지 않음).
    ...(SITE.editor.clinicStatus === 'open' && {
      worksFor: {
        '@type': 'MedicalClinic',
        name: SITE.editor.clinic,
        medicalSpecialty: 'InternalMedicine',
      },
    }),
  },
  publisher: orgPublisher,
  mainEntityOfPage: mainUrl,
  articleSection: cat.name,
  keywords: data.tags.join(', '),
  inLanguage: 'ko-KR',
  // 2026 SEO/GEO 강화 — Google AI Overview·News 친화 신호
  wordCount: wordCountEstimate,
  isAccessibleForFree: true,
  isPartOf: { '@id': `${SITE.url}/#website` },
  // Speakable — 음성 검색·AI 답변 인용 가능 영역 명시. h1 + 본문 첫 3 문단 우선.
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'article .prose > p:nth-of-type(-n+3)'],
  },
  // medical 글: 실명 의사(성주현)가 편집 총괄·의료 감수를 맡음 → reviewedBy/lastReviewed 정당.
  // (2026-07-07 감수자 부재로 제거했다가, 2026-07-20 실존 의사 감수자 확정으로 복원.)
  ...(data.medical && {
    medicalAudience: { '@type': 'MedicalAudience', audienceType: '일반 대중' },
    lastReviewed: (data.updatedDate ?? data.pubDate).toISOString().slice(0, 10),
    reviewedBy: {
      '@type': 'Person',
      name: SITE.editor.name,
      jobTitle: SITE.editor.medicalCredential,
      url: authorUrl,
      ...(SITE.editor.clinicStatus === 'open' && {
        worksFor: {
          '@type': 'MedicalClinic',
          name: SITE.editor.clinic,
          medicalSpecialty: 'InternalMedicine',
        },
      }),
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: '전문의 자격',
        name: SITE.editor.medicalCredential,
      },
      knowsAbout: SITE.editor.expertise,
    },
  }),
};

const faqSchema = data.faqs && data.faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: SITE.url + '/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: cat.name,
      item: new URL(`/category/${cat.slug}/`, SITE.url).toString(),
    },
    { '@type': 'ListItem', position: 3, name: data.title, item: mainUrl },
  ],
};

// 본문 이미지 alt — 단순 제목만 두면 키워드 부족. 카테고리 맥락을 더해 검색 가시성 ↑.
const bodyImageAlt = `${data.title} — ${cat.name} 관련 일러스트 (${SITE.name})`;
// 글마다 같은 카드와 같은 hero 이미지 (slug 기반 deterministic).
const heroImg = pickImage(data.category, articleSlug(article), bodyImageAlt);

// 글별 OG/SEO 이미지 — own-domain PNG. JSON-LD 와 og:image 양쪽에서 참조.
// satori 가 1200x630 (OG 표준) 으로 렌더링 — og:image:width/height 와 일치해야 함.
const ogImageSlug = articleSlug(article);
const ogImagePath = `/og/${ogImageSlug}.png`;
const ogImageUrl = new URL(ogImagePath, SITE.url).toString();
// og:image:alt — 한국어 키워드 풍부화. 제목 + 카테고리 + 상위 태그 3개.
// 태그가 없으면 끝의 빈 괄호를 제거.
const ogImageAltTags = data.tags.slice(0, 3).join('·');
const ogImageAlt = ogImageAltTags
  ? `${data.title} — ${SITE.name} ${cat.name} 가이드 (${ogImageAltTags})`
  : `${data.title} — ${SITE.name} ${cat.name} 가이드`;
// JSON-LD 의 image 도 ImageObject 로 — Google 이미지 검색 메타 강화.
articleSchema.image = [{
  '@type': 'ImageObject',
  url: ogImageUrl,
  width: 1200,
  height: 630,
  caption: ogImageAlt,
}];
// 외부 출처가 있으면 schema.org citation 으로도 노출 (LLM·검색 엔진 인용 가시성 ↑).
if (data.sources && data.sources.length > 0) {
  articleSchema.citation = data.sources.map((s) => ({
    '@type': 'CreativeWork',
    name: s.name,
    url: s.url,
  }));
}
const jsonLdGraph = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  noindex={!isPublicCategory(data.category)}
  title={data.title}
  description={data.description}
  type="article"
  image={ogImagePath}
  imageAlt={ogImageAlt}
  imageWidth={1200}
  imageHeight={630}
  imageType="image/png"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.pubDate).toISOString()}
  articleSection={cat.name}
  articleTags={data.tags}
  articleAuthorUrl={authorUrl}
  jsonLd={jsonLdGraph}
>
  <div class="container-x py-6 lg:py-10">
    <Breadcrumbs items={[
      { name: '홈', href: '/' },
      { name: cat.name, href: `/category/${cat.slug}/` },
      { name: data.title },
    ]} />

    {/* 일러스트형 메인 hero — 제목 텍스트가 박힌 카테고리 그라데이션 */}
    <div class="mt-4 -mx-4 sm:mx-0 sm:rounded-lg overflow-hidden">
      <HeroCard title={data.title} category={data.category} slug={articleSlug(article)} variant="hero" />
    </div>

    <div class="mt-4 grid lg:grid-cols-[1fr_300px] gap-8">
      <article class="min-w-0">
        <header class="mb-6">
          <div class="flex items-center gap-2 text-sm">
            <a href={`/category/${cat.slug}/`} class={`pill ring-1 ${cat.color} hover:opacity-80`}>{cat.emoji} {cat.name}</a>
            {data.subcategory && <span class="text-slate-400 text-xs">{data.subcategory}</span>}
          </div>
          <h1 class="mt-3 text-2xl md:text-3xl lg:text-4xl font-bold text-slate-900 leading-tight">{data.title}</h1>
          <p class="mt-3 text-slate-600 leading-relaxed">{data.description}</p>
          <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
            <span>{data.author}</span>
            <span class="text-slate-300">·</span>
            <time datetime={data.pubDate.toISOString()}>{dateStr}</time>
            <span class="text-slate-300">·</span>
            <span>읽는 시간 약 {readingMinutes}분</span>
          </div>
          {data.medical ? (
            /* 의료 글 — 감수자 자격·소속·검토일까지 노출. 이름만 적으면 신호가 약하다. */
            <div class="mt-2 text-xs text-slate-500 leading-relaxed">
              의료 감수 <a href={authorUrl} class="font-medium text-slate-600 hover:text-brand-700">{SITE.editor.name}</a>
              <span class="text-slate-400"> · {SITE.editor.medicalCredential}{SITE.editor.clinicStatus === 'open' ? ` · ${SITE.editor.clinic}` : ''}</span>
              <span class="text-slate-300"> · </span>
              <span>최종 검토 <time datetime={reviewedDate.toISOString()}>{reviewedDateStr}</time></span>
            </div>
          ) : (
            /* 비의료 글 — 편집 총괄자만 표기(감수 주장 없이). */
            <div class="mt-2 text-xs text-slate-500">
              편집 총괄 <a href={authorUrl} class="font-medium text-slate-600 hover:text-brand-700">{SITE.editor.name}</a>
            </div>
          )}
        </header>

        {/* AdSense Low value content review 후 본문 시작 직후 광고 제거 (2026-05-30).
            본문 끝 + sidebar 의 광고 2개는 유지. above-the-fold ad 가 부정적 시그널이라
            review 통과 후 점진 복원 검토. */}

        <TableOfContents headings={headings} />

        <div class="prose prose-slate max-w-none">
          <slot />
          {heroImg && (
            <figure id="hp-body-img" class="not-prose my-10">
              <div class="aspect-[16/9] overflow-hidden rounded-lg bg-slate-100" style={heroImg.bgColor ? `background-color:${heroImg.bgColor}` : undefined}>
                <img
                  src={heroImg.src}
                  srcset={`${heroImg.srcThumb} 600w, ${heroImg.src} 1200w`}
                  sizes="(min-width: 1024px) 720px, 100vw"
                  alt={heroImg.alt}
                  loading="lazy"
                  decoding="async"
                  width={1200}
                  height={675}
                  class="w-full h-full object-cover"
                />
              </div>
              <figcaption class="mt-2 text-[11px] text-slate-400 text-right">
                Photo by <a href={`${heroImg.attribution.photographerUrl}?utm_source=healthpick&utm_medium=referral`} class="underline" rel="nofollow noopener" target="_blank">{heroImg.attribution.photographer}</a> on <a href="https://unsplash.com/?utm_source=healthpick&utm_medium=referral" class="underline" rel="nofollow noopener" target="_blank">Unsplash</a>
              </figcaption>
            </figure>
          )}
        </div>

        {/* 본문 중간으로 사진을 옮겨 시각적 휴식 + dwell time 확보.
            SSR 으로는 본문 끝에 있어 크롤러는 항상 보지만, 사용자는 H2 중간 위치에서 봄. */}
        <script is:inline>
          (() => {
            const fig = document.getElementById('hp-body-img');
            const prose = document.querySelector('article .prose');
            if (!fig || !prose) return;
            const h2s = prose.querySelectorAll('h2');
            if (h2s.length < 4) return;
            const target = h2s[Math.floor(h2s.length / 2)];
            if (!target) return;
            target.before(fig);
          })();
        </script>

        <AdSlot label="광고" />

        {data.tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2">
            {data.tags.map((t) => (
              // rel=nofollow — tag 페이지는 sitemap 에서 제외(8981d085)했고 thin tag 는 noindex.
              // 크롤러가 tag 로 crawl budget 낭비하지 않게 nofollow. 사용자 탐색용으로만 유지.
              <a href={`/tag/${encodeURIComponent(t)}/`} rel="nofollow" class="pill ring-1 ring-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100">
                #{t}
              </a>
            ))}
          </div>
        )}

        {data.sources && data.sources.length > 0 && (
          <section class="not-prose mt-10 p-4 rounded-lg border border-slate-200 bg-slate-50">
            <h2 class="text-sm font-semibold text-slate-900 mb-2">참고한 자료</h2>
            <ol class="list-decimal pl-5 text-sm text-slate-700 space-y-1">
              {data.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline break-all">
                    {s.name}
                  </a>
                </li>
              ))}
            </ol>
            <p class="mt-3 text-xs text-slate-500">
              위 출처는 본문에서 다룬 일반적 정보의 1차 근거입니다. 시점에 따라 가이드라인이 갱신될 수 있으므로 각 기관의 최신 안내를 함께 확인해 주세요.
            </p>
          </section>
        )}

        <div class="mt-10 p-4 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-900">
          <strong>유의사항.</strong> 이 글의 내용은 일반적인 정보 제공을 목적으로 작성되었으며, 개인의 상황에 따라 다르게 적용될 수 있습니다. 의료·법률·금융 등 전문적 판단이 필요한 사안은 반드시 해당 분야의 전문가와 상담하시기 바랍니다.
        </div>

        {/* 본문 안 contextual 인라인 링크 — 크롤러가 사이드바보다 본문 텍스트 링크를 더 중시.
            관련성 높은 글로 crawl path 깊이 + 내부 링크 신호 강화 (2026-06-14, GSC 색인율 개선). */}
        {related.length > 0 && (
          <div class="mt-8 p-4 rounded-lg border border-brand-100 bg-brand-50/40 text-sm leading-relaxed text-slate-700">
            <span class="font-semibold text-slate-900">함께 보면 좋은 글 — </span>
            {related.slice(0, 3).map((a, i) => (
              <>
                {i > 0 && <span class="text-slate-400"> · </span>}
                <a href={articleHref(a)} class="text-brand-700 font-medium hover:underline">{a.data.title}</a>
              </>
            ))}
          </div>
        )}

        {related.length > 0 && (
          <section class="mt-12">
            <h2 class="text-xl font-bold text-slate-900 mb-4">관련 글</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {related.slice(0, 4).map((a) => <ArticleCard article={a} />)}
            </div>
          </section>
        )}
      </article>

      <aside class="lg:sticky lg:top-20 lg:self-start space-y-6">
        <AdSlot label="광고" />

        <div class="card p-4">
          <h3 class="text-sm font-semibold text-slate-900 mb-2">{cat.name} 인기 글</h3>
          <div class="divide-y divide-slate-100">
            {related.slice(0, 5).map((a) => <ArticleCard article={a} variant="compact" />)}
          </div>
        </div>

        <div class="card p-4">
          <h3 class="text-sm font-semibold text-slate-900 mb-2">다른 주제도 둘러보기</h3>
          <div class="divide-y divide-slate-100">
            {more.map((a) => <ArticleCard article={a} variant="compact" />)}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
