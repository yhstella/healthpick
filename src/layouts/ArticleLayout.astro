---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry, MarkdownHeading } from 'astro:content';
import { SITE, CATEGORIES } from '@lib/site';
import AdSlot from '@components/AdSlot.astro';
import ArticleCard from '@components/ArticleCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TableOfContents from '@components/TableOfContents.astro';
import { articleSlug } from '@lib/article';
import { pickImage } from '@lib/images';

export interface Props {
  article: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
  readingMinutes: number;
}

const { article, headings, readingMinutes } = Astro.props;
const { data } = article;
const cat = CATEGORIES[data.category];

const dateStr = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.pubDate);

const all = await getCollection('articles', ({ data }) => !data.draft);
const related = all
  .filter((a) => a.slug !== article.slug && a.data.category === data.category)
  .sort(() => Math.random() - 0.5)
  .slice(0, 6);
const more = all
  .filter((a) => a.slug !== article.slug && a.data.category !== data.category)
  .sort(() => Math.random() - 0.5)
  .slice(0, 4);

const mainUrl = new URL(Astro.url.pathname, SITE.url).toString();
const logoUrl = new URL('/favicon.svg', SITE.url).toString();
const orgPublisher = {
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: logoUrl },
};

// 헬스픽 = YMYL 건강 도메인. 의료 카테고리는 MedicalWebPage 로 신호.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': data.medical ? ['MedicalWebPage', 'Article'] : 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: data.author,
    url: new URL('/author/healthpick-team/', SITE.url).toString(),
  },
  publisher: orgPublisher,
  mainEntityOfPage: mainUrl,
  articleSection: cat.name,
  keywords: data.tags.join(', '),
  inLanguage: 'ko-KR',
  ...(data.medical && {
    medicalAudience: { '@type': 'MedicalAudience', audienceType: '일반 대중' },
    lastReviewed: (data.updatedDate ?? data.pubDate).toISOString().slice(0, 10),
    reviewedBy: orgPublisher,
  }),
};

const faqSchema = data.faqs && data.faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: SITE.url + '/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: cat.name,
      item: new URL(`/category/${cat.slug}/`, SITE.url).toString(),
    },
    { '@type': 'ListItem', position: 3, name: data.title, item: mainUrl },
  ],
};

// 글마다 같은 카드와 같은 hero 이미지 (slug 기반 deterministic).
const heroImg = pickImage(data.category, articleSlug(article), data.title);

// 여러 JSON-LD 를 한 번에 넘기기 위해 그래프 형태로 묶지 않고 배열로 통과.
// ImageObject 도 함께 (Article schema 의 image 속성으로도 들어감).
if (heroImg) {
  articleSchema.image = [heroImg.srcHero];
}
// 외부 출처가 있으면 schema.org citation 으로도 노출 (LLM·검색 엔진 인용 가시성 ↑).
if (data.sources && data.sources.length > 0) {
  articleSchema.citation = data.sources.map((s) => ({
    '@type': 'CreativeWork',
    name: s.name,
    url: s.url,
  }));
}
const jsonLdGraph = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.pubDate).toISOString()}
  jsonLd={jsonLdGraph}
>
  <div class="container-x py-6 lg:py-10">
    <Breadcrumbs items={[
      { name: '홈', href: '/' },
      { name: cat.name, href: `/category/${cat.slug}/` },
      { name: data.title },
    ]} />

    {heroImg && (
      <figure class="mt-4 -mx-4 sm:mx-0 sm:rounded-lg overflow-hidden bg-slate-100" style={heroImg.bgColor ? `background-color:${heroImg.bgColor}` : undefined}>
        <div class="aspect-[16/9] sm:aspect-[21/9]">
          <img
            src={heroImg.src}
            srcset={`${heroImg.src} 1200w, ${heroImg.srcHero} 1920w`}
            sizes="(min-width: 1024px) 768px, 100vw"
            alt={heroImg.alt}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width={1200}
            height={675}
            class="w-full h-full object-cover"
          />
        </div>
        <figcaption class="text-[10px] text-slate-400 px-4 sm:px-2 py-1 text-right">
          Photo by <a href={`${heroImg.attribution.photographerUrl}?utm_source=healthpick&utm_medium=referral`} class="underline" rel="nofollow noopener" target="_blank">{heroImg.attribution.photographer}</a> on <a href="https://unsplash.com/?utm_source=healthpick&utm_medium=referral" class="underline" rel="nofollow noopener" target="_blank">Unsplash</a>
        </figcaption>
      </figure>
    )}

    <div class="mt-4 grid lg:grid-cols-[1fr_300px] gap-8">
      <article class="min-w-0">
        <header class="mb-6">
          <div class="flex items-center gap-2 text-sm">
            <a href={`/category/${cat.slug}/`} class={`pill ring-1 ${cat.color} hover:opacity-80`}>{cat.emoji} {cat.name}</a>
            {data.subcategory && <span class="text-slate-400 text-xs">{data.subcategory}</span>}
          </div>
          <h1 class="mt-3 text-2xl md:text-3xl lg:text-4xl font-bold text-slate-900 leading-tight">{data.title}</h1>
          <p class="mt-3 text-slate-600 leading-relaxed">{data.description}</p>
          <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
            <span>{data.author}</span>
            <span class="text-slate-300">·</span>
            <time datetime={data.pubDate.toISOString()}>{dateStr}</time>
            <span class="text-slate-300">·</span>
            <span>읽는 시간 약 {readingMinutes}분</span>
          </div>
        </header>

        <AdSlot label="광고" />

        <TableOfContents headings={headings} />

        <div class="prose prose-slate max-w-none">
          <slot />
        </div>

        <AdSlot label="광고" />

        {data.tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2">
            {data.tags.map((t) => (
              <a href={`/tag/${encodeURIComponent(t)}/`} class="pill ring-1 ring-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100">
                #{t}
              </a>
            ))}
          </div>
        )}

        {data.sources && data.sources.length > 0 && (
          <section class="not-prose mt-10 p-4 rounded-lg border border-slate-200 bg-slate-50">
            <h2 class="text-sm font-semibold text-slate-900 mb-2">참고한 자료</h2>
            <ol class="list-decimal pl-5 text-sm text-slate-700 space-y-1">
              {data.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline break-all">
                    {s.name}
                  </a>
                </li>
              ))}
            </ol>
            <p class="mt-3 text-xs text-slate-500">
              위 출처는 본문에서 다룬 일반적 정보의 1차 근거입니다. 시점에 따라 가이드라인이 갱신될 수 있으므로 각 기관의 최신 안내를 함께 확인해 주세요.
            </p>
          </section>
        )}

        <div class="mt-10 p-4 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-900">
          <strong>유의사항.</strong> 이 글의 내용은 일반적인 정보 제공을 목적으로 작성되었으며, 개인의 상황에 따라 다르게 적용될 수 있습니다. 의료·법률·금융 등 전문적 판단이 필요한 사안은 반드시 해당 분야의 전문가와 상담하시기 바랍니다.
        </div>

        {related.length > 0 && (
          <section class="mt-12">
            <h2 class="text-xl font-bold text-slate-900 mb-4">관련 글</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {related.slice(0, 4).map((a) => <ArticleCard article={a} />)}
            </div>
          </section>
        )}
      </article>

      <aside class="lg:sticky lg:top-20 lg:self-start space-y-6">
        <AdSlot label="광고" />

        <div class="card p-4">
          <h3 class="text-sm font-semibold text-slate-900 mb-2">{cat.name} 인기 글</h3>
          <div class="divide-y divide-slate-100">
            {related.slice(0, 5).map((a) => <ArticleCard article={a} variant="compact" />)}
          </div>
        </div>

        <div class="card p-4">
          <h3 class="text-sm font-semibold text-slate-900 mb-2">다른 주제도 둘러보기</h3>
          <div class="divide-y divide-slate-100">
            {more.map((a) => <ArticleCard article={a} variant="compact" />)}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
