---
import '@/styles/global.css';
import { SITE } from '@lib/site';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
  articleAuthorUrl?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description = SITE.description,
  canonical,
  image = SITE.ogImage,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags,
  articleAuthorUrl,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site ?? SITE.url);
const ogImageURL = new URL(image, Astro.site ?? SITE.url);
// og:image:alt 가 명시되지 않으면 제목 또는 사이트 설명으로 fallback. 한국어 키워드 풍부화.
const ogImageAlt = imageAlt ?? (title ? `${title} — ${SITE.name} 가이드 일러스트` : `${SITE.name} — ${SITE.tagline}`);

// 사이트 전역 schema.org — 모든 페이지에 1회 송출. Google Knowledge Graph + sitelinks
// 검색박스 + AI Overview 인용 시그널. 2026 SEO/GEO 권장 (WebSite + Organization + SearchAction).
const siteOrgUrl = SITE.url;
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteOrgUrl}/#website`,
    name: SITE.name,
    alternateName: SITE.brandEn,
    url: siteOrgUrl,
    description: SITE.description,
    inLanguage: 'ko-KR',
    publisher: { '@id': `${siteOrgUrl}/#organization` },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteOrgUrl}/search/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteOrgUrl}/#organization`,
    name: SITE.name,
    alternateName: SITE.brandEn,
    url: siteOrgUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', siteOrgUrl).toString(),
    },
    description: SITE.description,
    foundingDate: '2026',
    knowsLanguage: ['ko-KR'],
    // 운영·발행 주체 = 큐레이션랩. 편집 총괄·의료 감수 = 실명 편집장(성주현).
    parentOrganization: { '@type': 'Organization', name: SITE.editor.org },
    // 🚨 @id 는 전용 Person 프로필(/author/sung-juhyun/)의 것과 정확히 일치해야
    //    구글이 사이트 전역 Organization ↔ 감수자 Person 을 같은 실체로 병합한다.
    employee: {
      '@type': 'Person',
      '@id': `${siteOrgUrl}/author/sung-juhyun/#person`,
      name: SITE.editor.name,
      jobTitle: SITE.editor.specialty,
      url: `${siteOrgUrl}/author/sung-juhyun/`,
      // 개원 전에는 소속을 선언하지 않는다 (site.ts editor.clinicStatus 참조).
      ...(SITE.editor.clinicStatus === 'open' && {
        worksFor: {
          '@type': 'MedicalClinic',
          name: SITE.editor.clinic,
          medicalSpecialty: 'InternalMedicine',
        },
      }),
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'editorial',
      email: SITE.contactEmail,
      areaServed: 'KR',
      availableLanguage: ['Korean'],
    },
    sameAs: SITE.twitter ? [`https://x.com/${SITE.twitter.replace(/^@/, '')}`] : [],
  },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* 폰트 CDN preconnect — global.css 의 @import(pretendard) 크리티컬 체인 단축 (FCP 개선) */}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    {SITE.gsc && <meta name="google-site-verification" content={SITE.gsc} />}
    {SITE.naverSearchAdvisor && <meta name="naver-site-verification" content={SITE.naverSearchAdvisor} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    {type === 'article' && articleAuthorUrl && <meta property="article:author" content={articleAuthorUrl} />}
    {type === 'article' && articleTags && articleTags.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
    {SITE.twitter && <meta name="twitter:creator" content={SITE.twitter} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Sitewide schema.org — WebSite + Organization + SearchAction (모든 페이지) */}
    {siteJsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    {/* Page-specific schema.org (Article, MedicalWebPage, FAQPage 등) */}
    {jsonLd && (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    {/* AdSense 로더 — noindex(검색·404·thin tag·paginated) 페이지엔 로드하지 않음.
        광고는 색인되는 콘텐츠 페이지에만. (2026-07-07 UX 감사) */}
    {SITE.adsense.enabled && SITE.adsense.clientId && !noindex && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense.clientId}`}
        crossorigin="anonymous"
      ></script>
    )}

    {SITE.ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script>
        <script is:inline define:vars={{ ga: SITE.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga);
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
