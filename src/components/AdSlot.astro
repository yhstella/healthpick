---
import { SITE } from '@lib/site';

export interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle';
  layout?: string;
  className?: string;
  label?: string;
}

const {
  slot = '0000000000',
  format = 'auto',
  layout,
  className = '',
  label = '광고',
} = Astro.props;

// AdSense 심사 단계에서 placeholder slot (0000000000) 으로 <ins> 렌더하면
// '빈 광고 슬롯' 정책 위반 위험 — 실제 slot ID 가 주어진 경우에만 렌더.
// 승인 후 dashboard 에서 Auto Ads 켜거나, 각 호출에 slot={...} 명시하면 실제 광고 노출.
const hasRealSlot = slot && slot !== '0000000000';
const enabled = SITE.adsense.enabled && !!SITE.adsense.clientId && hasRealSlot;
---

{/* AdSense placeholder slot 일 때 (승인 전) 컴포넌트 자체를 안 그림.
    개발자 메모 ("광고 자리 (AdSense 승인 후 자동 노출)") 가 사용자에게 노출되던 P0 fix
    (2026-05-30 페르소나 검토 결과). 승인 후 dashboard 에서 slot ID 부여하면 자연 노출. */}
{enabled && (
  <div class={`adslot my-6 ${className}`}>
    <p class="text-[10px] uppercase tracking-wider text-slate-400 mb-1">{label}</p>
    <ins
      class="adsbygoogle block"
      style="display:block"
      data-ad-client={SITE.adsense.clientId}
      data-ad-slot={slot}
      data-ad-format={format}
      data-ad-layout={layout}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
