---
// 글마다 카테고리 그라데이션 위에 제목 텍스트가 올라가는 일러스트형 hero.
// AI 양산 사이트의 stock-photo 톤과 가장 큰 시각적 차별점이 되는 컴포넌트.
//
// 사용:
//   <HeroCard title={data.title} category={data.category} slug={articleSlug(article)} variant="card" />
//   variant: 'card' (홈 카드) | 'hero' (글 페이지 메인) — 사이즈만 다름.
//   slug 가 주어지면 슬러그 해시로 6개 디자인 변형 중 하나가 deterministic 하게 선택됨.
//   slug 없으면 'classic' 고정.

import { CATEGORIES, type CategorySlug } from '@lib/site';
import { pickHeroVariant, type HeroVariant } from '@lib/hero-variant';

export interface Props {
  title: string;
  category: CategorySlug;
  slug?: string;
  variant?: 'card' | 'hero';
  /** style 을 직접 지정 (OG endpoint 와 미리보기 일치 용도) */
  style?: HeroVariant;
}

const { title, category, slug, variant = 'card', style } = Astro.props;
const cat = CATEGORIES[category];

// 카테고리별 파스텔 그라데이션 (배경) + 진한 액센트(데코·칩) 컬러.
type Palette = { bgA: string; bgB: string; accentBg: string; accentText: string };
const PALETTES: Record<CategorySlug, Palette> = {
  health:  { bgA: '#FFE4E6', bgB: '#FBCFE8', accentBg: '#fb7185', accentText: '#fff' },
  living:  { bgA: '#FEF3C7', bgB: '#FED7AA', accentBg: '#f59e0b', accentText: '#fff' },
  finance: { bgA: '#D1FAE5', bgB: '#A7F3D0', accentBg: '#10b981', accentText: '#fff' },
  tech:    { bgA: '#DBEAFE', bgB: '#BFDBFE', accentBg: '#3b82f6', accentText: '#fff' },
  auto:    { bgA: '#E2E8F0', bgB: '#CBD5E1', accentBg: '#475569', accentText: '#fff' },
  travel:  { bgA: '#E0E7FF', bgB: '#C7D2FE', accentBg: '#6366f1', accentText: '#fff' },
  study:   { bgA: '#EDE9FE', bgB: '#DDD6FE', accentBg: '#8b5cf6', accentText: '#fff' },
};
const p = PALETTES[category];

const layout: HeroVariant = style ?? (slug ? pickHeroVariant(slug) : 'classic');

// diagonal 변형만 gradient 각도가 다름 — 인라인 style 로 분기
const gradientAngle = layout === 'diagonal' ? 45 : 135;
const bg = `background: linear-gradient(${gradientAngle}deg, ${p.bgA} 0%, ${p.bgB} 100%);`;
---

<div
  class:list={[
    'healthpick-hero relative w-full aspect-[16/9] overflow-hidden',
    variant === 'hero' ? 'is-hero' : 'is-card',
    `style-${layout}`,
  ]}
  style={bg}
  data-style={layout}
>
  {/* === classic: 2 circles + dot pattern + 큰 이모지 우상단 === */}
  {layout === 'classic' && (
    <>
      <span class="hp-deco hp-deco-1" aria-hidden="true"></span>
      <span class="hp-deco hp-deco-2" aria-hidden="true"></span>
      <span class="hp-deco-dots" aria-hidden="true"></span>
      <span class="hp-emoji hp-emoji-tr" aria-hidden="true">{cat.emoji}</span>
      <span class="hp-title hp-title-tl" aria-hidden="true">{title}</span>
    </>
  )}

  {/* === pattern: 이모지를 작은 타일로 깔고 데코 X === */}
  {layout === 'pattern' && (
    <>
      <span class="hp-emoji-tile" aria-hidden="true">
        {Array.from({ length: 16 }).map(() => <span>{cat.emoji}</span>)}
      </span>
      <span class="hp-title hp-title-center-strong" aria-hidden="true">{title}</span>
    </>
  )}

  {/* === stripe: 좌측 두꺼운 컬러 스트라이프, 제목은 옆 === */}
  {layout === 'stripe' && (
    <>
      <span class="hp-stripe" style={`background:${p.accentBg};`} aria-hidden="true"></span>
      <span class="hp-emoji hp-emoji-stripe" aria-hidden="true">{cat.emoji}</span>
      <span class="hp-title hp-title-stripe" aria-hidden="true">{title}</span>
    </>
  )}

  {/* === bubble: 큰 translucent 원 5개, 우하단 이모지 === */}
  {layout === 'bubble' && (
    <>
      <span class="hp-bubble hp-bubble-1" aria-hidden="true"></span>
      <span class="hp-bubble hp-bubble-2" aria-hidden="true"></span>
      <span class="hp-bubble hp-bubble-3" aria-hidden="true"></span>
      <span class="hp-bubble hp-bubble-4" aria-hidden="true"></span>
      <span class="hp-bubble hp-bubble-5" aria-hidden="true"></span>
      <span class="hp-emoji hp-emoji-br" aria-hidden="true">{cat.emoji}</span>
      <span class="hp-title hp-title-tl" aria-hidden="true">{title}</span>
    </>
  )}

  {/* === diagonal: 가운데 강조 가로 선 + 작은 우상단 이모지 + 좌하단 제목 === */}
  {layout === 'diagonal' && (
    <>
      <span class="hp-diag-line" style={`background:${p.accentBg};opacity:0.35;`} aria-hidden="true"></span>
      <span class="hp-emoji hp-emoji-tr-sm" aria-hidden="true">{cat.emoji}</span>
      <span class="hp-title hp-title-bl" aria-hidden="true">{title}</span>
    </>
  )}

  {/* === minimal: 중앙 큰 이모지 + 그 아래 제목, 데코 X === */}
  {layout === 'minimal' && (
    <>
      <span class="hp-emoji hp-emoji-center" aria-hidden="true">{cat.emoji}</span>
      <span class="hp-title hp-title-center-small" aria-hidden="true">{title}</span>
    </>
  )}

  {/* === 공통: 좌하단 카테고리 칩 + 우하단 브랜드 마크 === */}
  <span class="hp-chip" style={`background:${p.accentBg};color:${p.accentText};`}>
    <span aria-hidden="true">{cat.emoji}</span>
    <span>{cat.name}</span>
  </span>
  <span class="hp-brand">헬스픽 · HealthPick</span>
</div>

<style>
  .healthpick-hero {
    font-family: Pretendard, -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    word-break: keep-all;
    overflow-wrap: break-word;
    container-type: inline-size;
  }

  /* ========= 공통: chip · brand · base sizing ========= */
  .hp-chip {
    position: absolute;
    bottom: 8%;
    left: 6%;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: -0.01em;
    z-index: 2;
  }
  .hp-brand {
    position: absolute;
    bottom: 8%;
    right: 6%;
    font-weight: 600;
    color: #475569;
    letter-spacing: -0.01em;
    opacity: 0.75;
    z-index: 2;
  }
  .is-card .hp-chip { font-size: 3.3cqw; }
  .is-hero .hp-chip { font-size: 2.2cqw; padding: 0.45em 1.1em; }
  .is-card .hp-brand { font-size: 2.8cqw; }
  .is-hero .hp-brand { font-size: 1.8cqw; }

  /* ========= 제목 base ========= */
  /* line-height 1.35 — 한글 받침 안 가리고, 두 줄 사이 충분히 떨어뜨림 */
  .hp-title {
    position: absolute;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.35;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    text-shadow: 0 1px 2px rgba(255,255,255,0.4);
    z-index: 1;
  }
  /* font-size 살짝 줄여서 늘어난 줄간격 보정 */
  .is-card .hp-title { font-size: 6.8cqw; }
  .is-hero .hp-title { font-size: 6.2cqw; }

  /* ========= 이모지 base ========= */
  .hp-emoji { position: absolute; line-height: 1; pointer-events: none; }

  /* ========= classic ========= */
  .hp-deco { position: absolute; border-radius: 50%; background: #fff; pointer-events: none; }
  .hp-deco-1 { top: -6%; right: -4%; width: 32%; aspect-ratio: 1; opacity: 0.35; }
  .hp-deco-2 { top: 18%; right: 8%; width: 8%; aspect-ratio: 1; opacity: 0.45; }
  .hp-deco-dots {
    position: absolute; bottom: 0; left: 0; width: 36%; height: 50%;
    background-image: radial-gradient(rgba(15,23,42,0.10) 1.2px, transparent 1.2px);
    background-size: 1.4em 1.4em;
    pointer-events: none;
    mask-image: linear-gradient(to top right, black, transparent 70%);
    -webkit-mask-image: linear-gradient(to top right, black, transparent 70%);
  }
  .hp-emoji-tr { top: 8%; right: 7%; opacity: 0.45; }
  .is-card .hp-emoji-tr { font-size: 18cqw; }
  .is-hero .hp-emoji-tr { font-size: 17cqw; }
  .hp-title-tl { top: 14%; left: 6%; right: 6%; }
  .is-hero .hp-title-tl { top: 13%; right: 30%; }

  /* ========= pattern ========= */
  .hp-emoji-tile {
    position: absolute; inset: 4% 4% 22% 4%;
    display: grid; grid-template-columns: repeat(4, 1fr);
    align-items: center; justify-items: center;
    opacity: 0.18; line-height: 1; pointer-events: none;
  }
  .is-card .hp-emoji-tile { font-size: 6.5cqw; }
  .is-hero .hp-emoji-tile { font-size: 5.5cqw; }
  .hp-emoji-tile > span { display: inline-block; transform: rotate(-8deg); }
  .hp-emoji-tile > span:nth-child(2n) { transform: rotate(6deg); }
  .hp-title-center-strong {
    top: 30%; left: 8%; right: 8%; text-align: center;
    background: rgba(255,255,255,0.6);
    padding: 0.4em 0.5em;
    border-radius: 8px;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    -webkit-line-clamp: 2;
  }

  /* ========= stripe ========= */
  .hp-stripe { position: absolute; top: 0; bottom: 0; left: 0; width: 14%; }
  .hp-emoji-stripe { top: 30%; left: 3%; transform: rotate(-6deg); color: #fff; opacity: 0.85; z-index: 1; }
  .is-card .hp-emoji-stripe { font-size: 9cqw; }
  .is-hero .hp-emoji-stripe { font-size: 7cqw; }
  .hp-title-stripe { top: 14%; left: 20%; right: 6%; }

  /* ========= bubble ========= */
  .hp-bubble { position: absolute; border-radius: 50%; background: #fff; pointer-events: none; }
  .hp-bubble-1 { top: -10%; left: -4%;  width: 32%; aspect-ratio: 1; opacity: 0.45; }
  .hp-bubble-2 { top:  10%; right: -6%; width: 38%; aspect-ratio: 1; opacity: 0.35; }
  .hp-bubble-3 { bottom: -12%; left: 25%; width: 30%; aspect-ratio: 1; opacity: 0.40; }
  .hp-bubble-4 { top:  35%; left: 22%; width: 12%; aspect-ratio: 1; opacity: 0.55; }
  .hp-bubble-5 { top:  55%; right: 28%; width: 16%; aspect-ratio: 1; opacity: 0.40; }
  .hp-emoji-br { bottom: 22%; right: 6%; opacity: 0.55; }
  .is-card .hp-emoji-br { font-size: 16cqw; }
  .is-hero .hp-emoji-br { font-size: 14cqw; }

  /* ========= diagonal ========= */
  .hp-diag-line {
    position: absolute; top: 45%; left: -10%; right: -10%;
    height: 18%;
    transform: rotate(-12deg);
  }
  .hp-emoji-tr-sm { top: 10%; right: 8%; opacity: 0.6; }
  .is-card .hp-emoji-tr-sm { font-size: 11cqw; }
  .is-hero .hp-emoji-tr-sm { font-size: 9cqw; }
  .hp-title-bl { bottom: 25%; left: 6%; right: 6%; }
  .is-hero .hp-title-bl { right: 40%; }

  /* ========= minimal ========= */
  .hp-emoji-center {
    top: 20%; left: 50%; transform: translateX(-50%);
    opacity: 0.85;
  }
  .is-card .hp-emoji-center { font-size: 24cqw; }
  .is-hero .hp-emoji-center { font-size: 22cqw; }
  .hp-title-center-small {
    top: 60%; left: 8%; right: 8%; text-align: center;
    -webkit-line-clamp: 2;
  }
  .is-card .style-minimal .hp-title { font-size: 6.5cqw; }
  .is-hero .style-minimal .hp-title { font-size: 5.5cqw; }

  /* ========= container query 폴백 ========= */
  @supports not (container-type: inline-size) {
    .is-card .hp-title { font-size: 1.5rem; }
    .is-card .hp-emoji { font-size: 4rem; }
    .is-card .hp-chip { font-size: 0.75rem; }
    .is-card .hp-brand { font-size: 0.7rem; }
    .is-hero .hp-title { font-size: 3rem; }
    .is-hero .hp-emoji { font-size: 7rem; }
    .is-hero .hp-chip { font-size: 1rem; }
    .is-hero .hp-brand { font-size: 0.85rem; }
  }
</style>
