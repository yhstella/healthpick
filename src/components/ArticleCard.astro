---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '@lib/site';
import { articleHref } from '@lib/article';

export interface Props {
  article: CollectionEntry<'articles'>;
  variant?: 'default' | 'compact' | 'hero';
}

const { article, variant = 'default' } = Astro.props;
const cat = CATEGORIES[article.data.category];
const href = articleHref(article);
const date = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(article.data.pubDate);
---

{variant === 'hero' && (
  <a href={href} class="card group block p-6 md:p-8 bg-gradient-to-br from-brand-50 to-white">
    <div class="flex items-center gap-2 text-xs">
      <span class={`pill ring-1 ${cat.color}`}>{cat.emoji} {cat.name}</span>
      <span class="text-slate-400">{date}</span>
    </div>
    <h2 class="mt-3 text-2xl md:text-3xl font-bold text-slate-900 group-hover:text-brand-700 transition">
      {article.data.title}
    </h2>
    <p class="mt-3 text-slate-600 line-clamp-3">{article.data.description}</p>
  </a>
)}

{variant === 'default' && (
  <a href={href} class="card group block">
    <div class="aspect-[16/9] flex items-center justify-center text-5xl bg-gradient-to-br from-slate-50 to-slate-100">
      <span>{article.data.heroEmoji || cat.emoji}</span>
    </div>
    <div class="p-4">
      <div class="flex items-center gap-2 text-xs">
        <span class={`pill ring-1 ${cat.color}`}>{cat.name}</span>
        <span class="text-slate-400">{date}</span>
      </div>
      <h3 class="mt-2 text-base font-semibold text-slate-900 group-hover:text-brand-700 transition line-clamp-2">
        {article.data.title}
      </h3>
      <p class="mt-1 text-sm text-slate-600 line-clamp-2">{article.data.description}</p>
    </div>
  </a>
)}

{variant === 'compact' && (
  <a href={href} class="group flex items-start gap-3 py-3 border-b border-slate-100 last:border-0">
    <span class="shrink-0 w-10 h-10 rounded-md bg-slate-50 flex items-center justify-center text-xl">
      {article.data.heroEmoji || cat.emoji}
    </span>
    <div class="min-w-0">
      <h4 class="text-sm font-medium text-slate-900 group-hover:text-brand-700 transition line-clamp-2">
        {article.data.title}
      </h4>
      <p class="mt-0.5 text-xs text-slate-500">{cat.name} · {date}</p>
    </div>
  </a>
)}
