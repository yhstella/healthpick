---
// Web3Forms 기반 문의 폼 — 정적 사이트에서 백엔드 없이 제출 → 이메일 수신.
// /contact/, /tip/ 등 여러 페이지에서 재사용. 한 페이지에 여러 개 둬도 각각 독립 동작.
//
// access key 는 public(클라이언트 노출)이며, 스팸은 honeypot + Web3Forms 측 필터로 방어.
const WEB3FORMS_KEY = '0b1115ae-9529-4817-b280-0d5f6cbfa292';

export interface Props {
  // 문의 유형 select 옵션 (value = 이메일 제목으로 사용). 미지정 시 기본 세트.
  subjects?: { value: string; label: string }[];
  // 제출 버튼 라벨
  submitLabel?: string;
}

const {
  subjects = [
    { value: '[헬스픽 문의] 주제 제안', label: '주제 제안 / 궁금한 질문' },
    { value: '[헬스픽 문의] 자료 공유', label: '자료·경험담 공유' },
    { value: '[헬스픽 문의] 제휴·광고', label: '제휴 · 광고' },
    { value: '[헬스픽 문의] 내용 오류 신고', label: '내용 오류 신고' },
    { value: '[헬스픽 문의] 기타', label: '기타' },
  ],
  submitLabel = '보내기',
} = Astro.props;
---

<form class="w3-contact-form not-prose rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 space-y-4">
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="from_name" value="헬스픽 문의 폼" />
  {/* 허니팟 — 봇이 채우면 제출 무시 (사용자에겐 안 보임) */}
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-semibold text-slate-800 mb-1">이름 <span class="text-rose-500">*</span></label>
      <input name="name" type="text" required autocomplete="name"
             class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition"
             placeholder="성함 또는 닉네임" />
    </div>
    <div>
      <label class="block text-sm font-semibold text-slate-800 mb-1">이메일 <span class="text-rose-500">*</span></label>
      <input name="email" type="email" required autocomplete="email"
             class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition"
             placeholder="답변받으실 이메일" />
    </div>
  </div>

  <div>
    <label class="block text-sm font-semibold text-slate-800 mb-1">문의 유형</label>
    <select name="subject"
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition">
      {subjects.map((s) => <option value={s.value}>{s.label}</option>)}
    </select>
  </div>

  <div>
    <label class="block text-sm font-semibold text-slate-800 mb-1">내용 <span class="text-rose-500">*</span></label>
    <textarea name="message" required rows="6"
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition resize-y"
              placeholder="다뤘으면 하는 주제, 질문, 배경, 참고 링크 등을 자유롭게 적어주세요."></textarea>
  </div>

  <button type="submit"
          class="w3-submit w-full inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 hover:bg-brand-700 disabled:opacity-60 disabled:cursor-not-allowed text-white px-5 py-3 font-semibold shadow-sm transition">
    <span class="w3-submit-text">{submitLabel}</span>
    <svg class="w3-spinner hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"></circle>
      <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
    </svg>
  </button>

  <p class="w3-result hidden text-sm rounded-lg px-3 py-2.5"></p>

  <p class="text-xs text-slate-400 leading-relaxed">
    보내주신 내용은 답변·다음 글 큐레이션 외 다른 용도로 사용하지 않습니다.
    익명 처리를 원하시면 본문에 적어주세요.
  </p>
</form>

<script is:inline>
  (() => {
    document.querySelectorAll('.w3-contact-form').forEach((form) => {
      if (form.dataset.wired) return;
      form.dataset.wired = '1';
      const result = form.querySelector('.w3-result');
      const btn = form.querySelector('.w3-submit');
      const btnText = form.querySelector('.w3-submit-text');
      const spinner = form.querySelector('.w3-spinner');
      const defaultLabel = btnText.textContent;

      function show(msg, ok) {
        result.textContent = msg;
        result.className = 'w3-result text-sm rounded-lg px-3 py-2.5 ' +
          (ok ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
              : 'bg-rose-50 text-rose-700 border border-rose-200');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (form.querySelector('input[name="botcheck"]').checked) return; // 허니팟

        btn.disabled = true;
        btnText.textContent = '보내는 중…';
        spinner.classList.remove('hidden');
        result.className = 'w3-result hidden';

        const data = Object.fromEntries(new FormData(form));
        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(data),
          });
          const json = await res.json();
          if (json.success) {
            show('보내주셔서 감사합니다. 영업일 기준 2~5일 이내에 답변드리겠습니다.', true);
            form.reset();
          } else {
            show('전송에 실패했습니다. 잠시 후 다시 시도하시거나 이메일로 보내주세요.', false);
          }
        } catch (err) {
          show('네트워크 오류로 전송하지 못했습니다. 잠시 후 다시 시도해 주세요.', false);
        } finally {
          btn.disabled = false;
          btnText.textContent = defaultLabel;
          spinner.classList.add('hidden');
        }
      });
    });
  })();
</script>
