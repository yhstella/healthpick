---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/site';

// 제보 유형별 카드 — mailto subject prefill 로 사용자가 한 번 클릭으로 메일 작성 시작
const tipTypes = [
  {
    emoji: '🔍',
    title: '사실 오류 제보',
    desc: '본문에서 잘못된 정보·오타·낡은 정책을 발견하셨다면 알려주세요. 페이지 URL과 함께 보내주시면 빠르게 확인하겠습니다.',
    subject: '[헬스픽 제보] 사실 오류 제보',
    body: `안녕하세요, 헬스픽 큐레이션 팀에 제보합니다.

문제가 된 페이지 URL:
발견하신 오류:
제안하는 수정 방향 (선택):
참고할 만한 출처 (선택):

`,
  },
  {
    emoji: '💡',
    title: '새 주제 제안',
    desc: '검색해도 답이 잘 안 나오는 주제, 다뤘으면 하는 분야가 있다면 알려주세요. 큐레이션 우선순위에 반영합니다.',
    subject: '[헬스픽 제보] 새 주제 제안',
    body: `안녕하세요, 헬스픽에서 다뤘으면 하는 주제를 제안합니다.

다뤄주셨으면 하는 주제:
관심을 가지게 된 배경 (선택):
참고할 만한 자료·링크 (선택):

`,
  },
  {
    emoji: '📚',
    title: '출처·자료 공유',
    desc: '기존 글보다 더 신뢰할 만한 1차 출처, 최신 가이드라인, 학회 자료를 알고 계신다면 공유해 주세요.',
    subject: '[헬스픽 제보] 출처·자료 공유',
    body: `안녕하세요, 출처·자료를 공유드립니다.

해당 페이지 URL (선택):
공유드리는 자료의 출처 (학회·기관·논문 등):
링크:
요약 또는 코멘트:

`,
  },
  {
    emoji: '🗣️',
    title: '경험담·후기',
    desc: '직접 겪은 경험을 공유해 주시면, 익명 처리하여 본문 참고 또는 사례 형태로 활용할 수 있습니다.',
    subject: '[헬스픽 제보] 경험담·후기 공유',
    body: `안녕하세요, 경험담을 공유드립니다.

관련 주제:
경험 요약:
다른 분들께 도움 될 만한 포인트:
익명 처리 희망 여부 (예/아니오):

`,
  },
];

const mailto = (subject: string, body: string) =>
  `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<BaseLayout
  title="큐레이션 팀에게 제보하기"
  description="헬스픽 큐레이션 팀은 독자 제보로 더 정확해집니다. 사실 오류, 새 주제 제안, 출처 공유, 경험담을 보내주세요."
>
  <div class="container-x py-10">
    <Breadcrumbs items={[{ name: '홈', href: '/' }, { name: '제보' }]} />

    <header class="mt-6 max-w-2xl">
      <span class="pill ring-1 ring-brand-200 bg-brand-50 text-brand-700">큐레이션 팀</span>
      <h1 class="mt-3 text-3xl md:text-4xl font-bold text-slate-900 leading-tight">
        헬스픽 큐레이션 팀에게<br />제보하세요
      </h1>
      <p class="mt-4 text-slate-600 leading-relaxed">
        헬스픽의 글은 검색 한 번으로 답을 찾을 수 있도록 정리되지만, 모든 정보를 처음부터 완벽히 담을 수는 없습니다.
        독자분들이 알려주시는 오류, 새 주제, 출처가 글의 신뢰도를 한 단계씩 끌어올립니다.
      </p>
      <p class="mt-2 text-slate-500 text-sm">
        보내주신 제보는 영업일 기준 <strong>2~5일 이내</strong>에 확인 답변을 드립니다. 사실 관계가 확인된 경우 본문에
        반영하고, 의미 있는 출처는 참고자료 섹션에 함께 게재합니다.
      </p>
    </header>

    <section class="mt-10">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">어떤 제보를 보내실 건가요?</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {tipTypes.map((t) => (
          <a
            href={mailto(t.subject, t.body)}
            class="card p-5 group hover:ring-2 hover:ring-brand-300 transition"
          >
            <div class="flex items-start gap-3">
              <span class="text-2xl shrink-0">{t.emoji}</span>
              <div class="min-w-0">
                <h3 class="text-base font-semibold text-slate-900 group-hover:text-brand-700 transition">
                  {t.title}
                </h3>
                <p class="mt-1 text-sm text-slate-600 leading-relaxed">{t.desc}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-700">
                  메일로 보내기
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
                    <path d="M5 12h14M13 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10 p-5 rounded-lg border border-slate-200 bg-slate-50">
      <h2 class="text-base font-semibold text-slate-900">메일을 직접 보내시는 분께</h2>
      <p class="mt-2 text-sm text-slate-600">
        위 버튼 대신 메일 클라이언트로 직접 보내고 싶으시다면, 아래 주소로 보내주세요. 메일 제목에 어떤 종류의 제보인지
        짧게 표기해 주시면 처리가 빨라집니다.
      </p>
      <p class="mt-3 text-sm">
        <span class="text-slate-500">받는 사람</span> ·
        <a href={`mailto:${SITE.contactEmail}`} class="font-medium text-brand-700 hover:underline ml-1">
          {SITE.contactEmail}
        </a>
      </p>
      <ul class="mt-3 text-sm text-slate-600 list-disc pl-5 space-y-1">
        <li>익명 제보를 원하시면 메일 본문에 "익명 처리 희망"이라고 적어주세요.</li>
        <li>스크린샷·문서를 첨부하셔도 좋습니다.</li>
        <li>제보 내용은 본문 반영, 출처 보강, 새 글 작성 외 다른 용도로 사용하지 않습니다.</li>
      </ul>
    </section>

    <section class="mt-10 max-w-2xl">
      <h2 class="text-base font-semibold text-slate-900">큐레이션 팀 한마디</h2>
      <blockquote class="mt-3 p-5 border-l-4 border-brand-300 bg-brand-50/40 text-slate-700 leading-relaxed">
        "헬스픽은 한 사람이 만든 사이트가 아니라, 글을 읽고 알려주시는 독자분들과 함께 매주 조금씩 더 정확해지는 사이트입니다.
        틀린 부분을 발견하셨다면 망설이지 마시고 알려주세요. 가장 빨리 고치는 길은 알려주시는 것입니다."
        <footer class="mt-3 text-sm text-slate-500">— 헬스픽 큐레이션 팀</footer>
      </blockquote>
    </section>
  </div>
</BaseLayout>
