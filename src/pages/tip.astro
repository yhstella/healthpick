---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/site';

// 제안 유형별 카드 — mailto subject prefill 로 사용자가 한 번 클릭으로 메일 작성 시작.
// '오류' 단어는 의도적으로 사용하지 않는다 — 사이트 신뢰도 표현 원칙.
const tipTypes = [
  {
    emoji: '💡',
    title: '다뤘으면 하는 주제',
    desc: '검색해도 답을 찾기 어려운 주제, 헬스픽에서 정리해 주었으면 하는 분야가 있다면 알려주세요. 다음 큐레이션 우선순위에 반영합니다.',
    subject: '[헬스픽 제안] 다뤘으면 하는 주제',
    body: `안녕하세요, 헬스픽에서 다뤘으면 하는 주제를 제안합니다.

다뤄주셨으면 하는 주제:
관심을 가지게 된 배경 (선택):
참고할 만한 자료·링크 (선택):

`,
  },
  {
    emoji: '❓',
    title: '검색해도 안 나오는 질문',
    desc: '평소 궁금했지만 검색해도 명쾌한 답을 찾기 어려운 질문이 있다면 보내주세요. 큐레이션 팀이 답이 정리되는 글로 만들어 봅니다.',
    subject: '[헬스픽 제안] 검색해도 안 나오는 질문',
    body: `안녕하세요, 평소 궁금했던 질문을 보냅니다.

질문:
이 질문이 생긴 배경 (선택):
이미 찾아본 자료가 있다면 (선택):

`,
  },
  {
    emoji: '📚',
    title: '함께 보면 좋을 자료',
    desc: '학회 가이드라인, 공식 기관 발표 자료, 신뢰할 만한 1차 출처를 알고 계신다면 함께 보내주세요. 다음 글에 참고 자료로 활용합니다.',
    subject: '[헬스픽 제안] 함께 보면 좋을 자료 공유',
    body: `안녕하세요, 자료를 공유드립니다.

관련 주제:
자료의 출처 (학회·기관·논문 등):
링크:
간단한 요약·코멘트 (선택):

`,
  },
  {
    emoji: '🗣️',
    title: '경험담·후기',
    desc: '직접 겪은 경험을 익명으로 공유해 주시면, 비슷한 상황의 다른 독자에게 도움 되는 정보로 정리합니다.',
    subject: '[헬스픽 제안] 경험담 공유',
    body: `안녕하세요, 경험담을 공유드립니다.

관련 주제:
경험 요약:
다른 분들께 도움 될 만한 포인트:
익명 처리 희망 여부 (예/아니오):

`,
  },
];

const mailto = (subject: string, body: string) =>
  `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<BaseLayout
  title="큐레이션 팀에 주제 제안하기"
  description="다뤘으면 하는 주제, 검색해도 답을 찾기 어려운 질문, 함께 보면 좋을 자료를 헬스픽 큐레이션 팀에 보내주세요."
>
  <div class="container-x py-10">
    <Breadcrumbs items={[{ name: '홈', href: '/' }, { name: '주제 제안' }]} />

    <header class="mt-6 max-w-2xl">
      <span class="pill ring-1 ring-brand-200 bg-brand-50 text-brand-700">큐레이션 팀</span>
      <h1 class="mt-3 text-3xl md:text-4xl font-bold text-slate-900 leading-tight">
        헬스픽에서 다뤘으면 하는<br />주제를 알려주세요
      </h1>
      <p class="mt-4 text-slate-600 leading-relaxed">
        헬스픽은 독자분들이 일상에서 가장 자주 검색하시는 주제에서 출발합니다.
        다음에 어떤 주제를 한 페이지로 정리해 보면 좋을지, 어떤 자료를 함께 참고하면 좋을지 알려주시면
        다음 큐레이션 작업에 우선순위로 반영합니다.
      </p>
      <p class="mt-2 text-slate-500 text-sm">
        보내주신 의견은 영업일 기준 <strong>2~5일 이내</strong>에 확인 답변을 드립니다.
        함께 공유해 주신 자료는 다음 글의 참고자료 섹션에서 함께 안내합니다.
      </p>
    </header>

    <section class="mt-10">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">어떤 의견을 보내실 건가요?</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {tipTypes.map((t) => (
          <a
            href={mailto(t.subject, t.body)}
            class="card p-5 group hover:ring-2 hover:ring-brand-300 transition"
          >
            <div class="flex items-start gap-3">
              <span class="text-2xl shrink-0">{t.emoji}</span>
              <div class="min-w-0">
                <h3 class="text-base font-semibold text-slate-900 group-hover:text-brand-700 transition">
                  {t.title}
                </h3>
                <p class="mt-1 text-sm text-slate-600 leading-relaxed">{t.desc}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-700">
                  메일로 보내기
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
                    <path d="M5 12h14M13 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10 p-5 rounded-lg border border-slate-200 bg-slate-50">
      <h2 class="text-base font-semibold text-slate-900">메일을 직접 보내시는 분께</h2>
      <p class="mt-2 text-sm text-slate-600">
        위 버튼 대신 메일 클라이언트로 직접 보내고 싶으시다면 아래 주소로 보내주세요.
        제목 앞에 어떤 종류의 의견인지 짧게 적어 주시면 처리가 빨라집니다.
      </p>
      <p class="mt-3 text-sm">
        <span class="text-slate-500">받는 사람</span> ·
        <a href={`mailto:${SITE.contactEmail}`} class="font-medium text-brand-700 hover:underline ml-1">
          {SITE.contactEmail}
        </a>
      </p>
      <ul class="mt-3 text-sm text-slate-600 list-disc pl-5 space-y-1">
        <li>익명 제안을 원하시면 메일 본문에 "익명 처리 희망"이라고 적어주세요.</li>
        <li>스크린샷·문서를 첨부하셔도 좋습니다.</li>
        <li>보내주신 내용은 다음 글 큐레이션 외 다른 용도로 사용하지 않습니다.</li>
      </ul>
    </section>

    <section class="mt-10 max-w-2xl">
      <h2 class="text-base font-semibold text-slate-900">큐레이션 팀 한마디</h2>
      <blockquote class="mt-3 p-5 border-l-4 border-brand-300 bg-brand-50/40 text-slate-700 leading-relaxed">
        "헬스픽은 독자분들이 일상에서 자주 검색하시는 주제에서 시작합니다.
        다뤘으면 하는 주제나 함께 보면 좋을 자료가 있으시면, 다음 큐레이션 작업에 반영합니다."
        <footer class="mt-3 text-sm text-slate-500">— 헬스픽 큐레이션 팀</footer>
      </blockquote>
    </section>
  </div>
</BaseLayout>
