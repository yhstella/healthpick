---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE, CATEGORIES, CATEGORY_ORDER } from '@lib/site';
import Breadcrumbs from '@components/Breadcrumbs.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.author,
  url: new URL('/author/healthpick-team/', SITE.url).toString(),
  parentOrganization: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  description: `${SITE.name} 콘텐츠를 기획·검토하는 편집팀.`,
  knowsAbout: CATEGORY_ORDER.map((slug) => CATEGORIES[slug].name),
  sameAs: [SITE.url],
};
---

<BaseLayout
  title={`${SITE.author} — ${SITE.name} 편집·감수 정책`}
  description={`${SITE.name}을 운영하는 편집팀의 편집 원칙, 감수 절차, 신뢰성 확보 방식.`}
  canonical="/author/healthpick-team/"
  jsonLd={jsonLd}
>
  <div class="container-x py-10">
    <Breadcrumbs items={[
      { name: '홈', href: '/' },
      { name: '편집팀 소개' },
    ]} />

    <article class="prose prose-slate max-w-3xl mt-6">
      <h1>{SITE.author}</h1>

      <p>
        <strong>{SITE.author}</strong>은 <a href="/">{SITE.name}</a>에 게시되는 모든 콘텐츠의 기획·작성·감수를
        담당합니다. 본 페이지는 사이트의 편집 원칙과 정보 신뢰성 확보 방식을 공개하기 위해 작성되었습니다.
      </p>

      <h2>편집 원칙 (Editorial Policy)</h2>
      <ol>
        <li><strong>출처가 분명한 일반 정보 우선.</strong> 의료·법률·금융 등 전문 영역의 내용은 공식 기관·전문 매체에서 일반적으로 받아들여지는 사항을 기준으로 정리합니다.</li>
        <li><strong>단정 회피, 한계 명시.</strong> 개인 차이가 큰 영역(증상·복용·투자)은 단정적 표현 대신 가능성·범위로 기술하고, 전문가 상담을 명시적으로 권합니다.</li>
        <li><strong>이해 충돌 분리.</strong> 광고 콘텐츠와 일반 기사를 명확히 구분하며, 광고가 기사 결론에 영향을 주지 않도록 합니다.</li>
        <li><strong>정확성 유지 책임.</strong> 최신 가이드라인·통계·정책 변경 사항을 정기적으로 점검해 본문에 반영하고, 큰 사안은 갱신 이력을 본문 하단에 명시합니다.</li>
        <li><strong>구독자·이용자 정보 보호.</strong> 개인정보·이메일·문의 내역은 <a href="/privacy/">개인정보처리방침</a>에 명시한 범위 내에서만 처리합니다.</li>
      </ol>

      <h2>YMYL(건강·재무) 안전 절차</h2>
      <p>
        건강·재무·법률 등 사용자의 삶에 영향을 줄 수 있는 영역(YMYL)에 대해서는 다음 절차를 따릅니다.
      </p>
      <ul>
        <li>일반인을 위한 정보 제공을 분명히 하고, 진단·처방·투자 권유로 오해할 수 있는 표현을 피합니다.</li>
        <li>본문 하단에 <a href="/disclaimer/">면책조항</a>을 항상 표시합니다.</li>
        <li>증상·약물·법령 등 시기에 따라 달라지는 정보는 게시 시점을 명시하고, 주기적으로 점검합니다.</li>
        <li>독자가 즉시 전문가 상담을 검토할 수 있도록 '병원 방문 시점', '전문 기관 연락처' 등을 함께 안내합니다.</li>
      </ul>

      <h2>다루는 분야</h2>
      <ul>
        {CATEGORY_ORDER.map((slug) => {
          const c = CATEGORIES[slug];
          return (
            <li><strong>{c.emoji} {c.name}</strong> — {c.description}</li>
          );
        })}
      </ul>

      <h2>출처 활용 정책</h2>
      <p>
        본 사이트의 콘텐츠는 공공 보건 기관, 정부 부처, 학회·협회의 공식 안내, 그리고 검증된 매체의 보도 자료에 의존합니다.
        구체적인 통계·수치를 인용하는 경우 출처를 명시하며, 본문 내 외부 링크는 가능한 한 1차 출처를 우선합니다.
      </p>
      <p><strong>우선 출처 (1차 출처)</strong>:</p>
      <ul>
        <li><strong>건강·의료</strong>: 질병관리청(KDCA), 보건복지부, 식품의약품안전처, 대한○○학회(예: 대한당뇨병학회·대한고혈압학회·대한간학회·대한내분비학회), WHO 가이드라인, 국가건강정보포털</li>
        <li><strong>재무·세무</strong>: 국세청, 금융감독원, 금융위원회, 한국은행, 통계청(KOSIS), 보건복지부(복지 정책)</li>
        <li><strong>생활·소비</strong>: 한국소비자원, 공정거래위원회, 국토교통부, 국민건강보험공단</li>
        <li><strong>법률</strong>: 법제처(국가법령정보센터), 대법원, 헌법재판소</li>
      </ul>
      <p>일반 매체·블로그·개인 자료·SNS 게시물은 1차 출처가 아니므로 인용 출처로 사용하지 않습니다.</p>

      <h2>콘텐츠 제작·감수 절차</h2>
      <p>모든 글은 다음 5단계 절차로 게시됩니다.</p>
      <ol>
        <li><strong>주제 선정</strong> — 실제 검색 트렌드와 독자 제안을 바탕으로 구체적·맥락적 질문을 도출합니다. 최근 게재 글과의 주제 중복을 점검합니다.</li>
        <li><strong>출처 수집</strong> — 위 1차 출처 목록을 우선 활용합니다. 작성 시점의 최신 가이드라인·통계를 확인합니다.</li>
        <li><strong>본문 작성</strong> — 결론부터 → 적용 조건 → 예외 → 비용·위험 → FAQ → 출처 순서의 6섹션 구조를 따릅니다. 구체 수치·임계치·시점을 본문에 명시합니다.</li>
        <li><strong>감수</strong> — YMYL 영역의 단정 표현, 의학적·법적 오류 가능성, 부정확한 수치, 면책 안내 누락을 점검합니다.</li>
        <li><strong>게시 및 갱신</strong> — 게시 후 정책·법령·가이드라인 변경 시 본문을 갱신하고 큰 사안은 갱신 이력을 명시합니다.</li>
      </ol>

      <h2>금지하는 콘텐츠 패턴</h2>
      <p>다음 패턴의 콘텐츠는 작성·게시하지 않습니다.</p>
      <ul>
        <li>"OOO 효능 10가지", "OOO 추천 순위" 같은 일반론·리스트 양산 글</li>
        <li>특정 약물·시술·금융 상품의 효과·수익을 단정하는 표현</li>
        <li>비교 광고를 가장한 특정 기업·제품에 유리한 결론</li>
        <li>출처 없는 통계·수치 인용, 임의 일반화</li>
        <li>응급 의료 상황을 본 사이트 정보로 해결하도록 유도하는 표현 (즉시 119 또는 응급실 안내가 우선)</li>
      </ul>

      <h2>독자 의견·자료 공유</h2>
      <p>
        다뤘으면 하는 주제, 함께 보면 좋을 자료, 최신 가이드라인·정책 변경 사항이 있다면
        <a href="/tip/">큐레이션 팀에 주제 제안하기</a> 또는 <a href="/contact/">문의 페이지</a>를 통해 보내주세요.
        가능한 한 빠르게 확인하고 다음 큐레이션에 반영합니다. 협업·제휴 문의도 같은 경로로 받습니다.
      </p>

      <h2>이용자 신뢰 확보를 위한 약속</h2>
      <ul>
        <li>광고를 위한 사실 왜곡·과장을 하지 않습니다.</li>
        <li>특정 기업·제품에 유리한 결론을 이끌어내기 위한 비교를 작성하지 않습니다.</li>
        <li>개인을 식별할 수 있는 정보를 동의 없이 게시하지 않습니다.</li>
      </ul>

      <p class="text-sm text-slate-500">최종 갱신: 2026-05-19</p>
    </article>
  </div>
</BaseLayout>
