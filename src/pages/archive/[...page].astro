---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublicCategory } from '@lib/site';
import ArticleCard from '@components/ArticleCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Pagination from '@components/Pagination.astro';

export async function getStaticPaths({ paginate }: any) {
  // 🚨 아카이브도 공개 카테고리만. 색인되는 목록 페이지에 비공개 글이 실리면
  //    "내렸다"는 신호와 어긋난다(noindex 글로 가는 색인된 링크가 남음).
  const all = await getCollection(
    'articles',
    ({ data }) => !data.draft && isPublicCategory(data.category)
  );
  const sorted = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(sorted, { pageSize: 30 });
}

const { page } = Astro.props as { page: any };

// 2페이지 이상은 noindex,follow — 1페이지가 hub 역할. paginated thin index 인덱싱 방지.
const isFirstPage = page.currentPage === 1;
const noindex = !isFirstPage;
const pageTitle = isFirstPage
  ? `전체 글 ${page.total}편 — 헬스픽 아카이브`
  : `전체 글 (${page.currentPage}/${page.lastPage}페이지)`;
---

<BaseLayout
  title={pageTitle}
  description="헬스픽에 등록된 모든 글을 최신순으로 모아 봅니다."
  noindex={noindex}
>
  <div class="container-x py-8">
    <Breadcrumbs items={[{ name: '홈', href: '/' }, { name: '전체 글' }]} />
    <header class="mt-3 mb-6">
      <h1 class="text-2xl md:text-3xl font-bold text-slate-900">전체 글</h1>
      <p class="mt-2 text-sm text-slate-500">총 {page.total}개 글 · {page.currentPage} / {page.lastPage} 페이지</p>
    </header>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {page.data.map((a: any) => <ArticleCard article={a} />)}
    </div>
    <Pagination page={page} />
  </div>
</BaseLayout>
