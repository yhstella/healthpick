---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_ORDER, SITE } from '@lib/site';
import ArticleCard from '@components/ArticleCard.astro';
import AdSlot from '@components/AdSlot.astro';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 큐레이터 픽 — 오늘 날짜를 seed 로 한 deterministic shuffle 로 7편 선정.
// 같은 날 같은 픽, 매일 다른 픽. featured: true 가 있으면 그 풀 우선, 없으면 전체 풀.
function fnv1a(str: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return h >>> 0;
}
function pickDaily<T extends { slug: string }>(arr: T[], n: number, seed: string): T[] {
  return arr
    .map((a) => ({ a, s: fnv1a(`${seed}|${a.slug}`) }))
    .sort((x, y) => x.s - y.s)
    .slice(0, n)
    .map((x) => x.a);
}
const dailySeed = new Date().toISOString().slice(0, 10);
const featuredPool = all.filter((a) => a.data.featured);
const curatorPicks = pickDaily(
  featuredPool.length >= 7 ? featuredPool : all,
  7,
  dailySeed,
);
const curatorSlugs = new Set(curatorPicks.map((a) => a.slug));
const latest = all.filter((a) => !curatorSlugs.has(a.slug)).slice(0, 8);
const byCategory = Object.fromEntries(
  CATEGORY_ORDER.map((slug) => [
    slug,
    all.filter((a) => a.data.category === slug).slice(0, 6),
  ])
);

// 신뢰 신호용 통계 — 글이 매주 늘어나도 자동 반영
const totalCount = all.length;
const totalLabel = totalCount >= 1000
  ? `${Math.floor(totalCount / 100) * 100}+`
  : String(totalCount);
const lastUpdated = all[0]?.data.pubDate;
const lastUpdatedStr = lastUpdated
  ? new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(lastUpdated)
  : '';
// 카테고리당 평균 글 수 — 양적 깊이 보여주는 신뢰 지표
const avgPerCategory = Math.floor(totalCount / CATEGORY_ORDER.length);
---

<BaseLayout>
  {/* 상단 얇은 신뢰 띠 — 헤더 아래 위치 */}
  <div class="border-b border-slate-100 bg-slate-50/60">
    <div class="container-x py-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-slate-500">
      <span class="inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        최근 업데이트 · {lastUpdatedStr}
      </span>
      <span class="hidden sm:inline text-slate-300">·</span>
      <a href="/tip/" class="font-medium text-brand-700 hover:underline">독자 주제 제안 받습니다 →</a>
    </div>
  </div>

  {/* 메인 히어로 — 편집부 톤으로 */}
  <section class="container-x pt-10 pb-6">
    <div class="grid lg:grid-cols-[1fr_300px] gap-8 items-start">
      <div class="max-w-2xl">
        <span class="inline-block pill ring-1 ring-brand-200 bg-brand-50 text-brand-700">
          {SITE.name} · 생활 검색형 가이드
        </span>
        <h1 class="mt-3 text-3xl md:text-4xl font-bold text-slate-900 leading-tight">
          한 줄로 검색이 안 되는<br class="hidden md:inline" />
          <span class="text-brand-700">실제 상황에 답을 드립니다</span>
        </h1>
        <p class="mt-4 text-slate-600 leading-relaxed">
          "건강검진에서 ALT 80이면 병원 가야 하나요?" "배터리 방전돼서 보험 부르면 보험료 오르나요?"
          처럼 일상에서 마주치는 구체적인 질문에 결론부터 짧고 정확하게 답합니다.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {CATEGORY_ORDER.map((slug) => {
            const c = CATEGORIES[slug];
            return (
              <a href={`/category/${slug}/`} class={`pill ring-1 ${c.color} hover:opacity-90`}>
                {c.emoji} {c.name}
              </a>
            );
          })}
        </div>
      </div>

      {/* 우측 작은 신뢰 패널 — 큐레이션 팀 노트 */}
      <aside class="card p-5 bg-white">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-brand-100 text-brand-700 text-sm font-bold">팀</span>
          <div>
            <div class="text-sm font-semibold text-slate-900">큐레이션 팀 노트</div>
            <div class="text-xs text-slate-500">매주 새 글 + 본문 보강</div>
          </div>
        </div>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          이번 주는 <strong class="text-slate-900">건강·재테크</strong> 영역에서 자주 검색되는 주제를 보강하고 있습니다.
          더 다뤘으면 하는 주제가 있으시면 알려주세요.
        </p>
        <a
          href="/tip/"
          class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-700 hover:underline"
        >
          관심 주제 보내기
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </aside>
    </div>

  </section>

  {curatorPicks.length > 0 && (
    <section class="container-x py-6">
      <div class="flex items-end justify-between mb-3">
        <h2 class="text-xl md:text-2xl font-bold text-slate-900">
          <span class="inline-block w-1.5 h-5 bg-brand-600 rounded-sm mr-2 align-middle"></span>
          오늘의 큐레이터 픽
        </h2>
        <span class="text-xs text-slate-500">매일 새로 고른 7편</span>
      </div>
      {/* 첫 번째 픽은 hero 카드, 나머지 6편은 그리드 */}
      <ArticleCard article={curatorPicks[0]} variant="hero" />
      <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {curatorPicks.slice(1).map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  {/* 편집 원칙 4카드 — 신뢰 강화, AI 사이트 느낌 완화 */}
  <section class="container-x py-8">
    <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-6 md:p-8">
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
        <span class="w-6 h-px bg-slate-300"></span>
        편집 원칙
      </div>
      <h2 class="mt-2 text-xl md:text-2xl font-bold text-slate-900">이런 기준으로 글을 씁니다</h2>
      <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {SITE.editorialPrinciples.map((p) => (
          <div class="p-4 rounded-lg bg-white border border-slate-200">
            <div class="text-sm font-semibold text-slate-900">{p.title}</div>
            <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-5 text-xs text-slate-500">
        자세한 운영 원칙은 <a href="/about/" class="font-medium text-brand-700 hover:underline">소개</a> 에 있습니다.
      </div>
    </div>
  </section>

  <section class="container-x py-6">
    <div class="flex items-end justify-between mb-4">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900">최신 글</h2>
      <a href="/archive/" class="text-sm text-brand-700 hover:underline">전체 보기 →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {latest.map((a) => <ArticleCard article={a} />)}
    </div>
  </section>

  {/* 주제 제안 CTA 띠 — 중간에 한 번 더 노출 */}
  <section class="container-x py-8">
    <div class="rounded-2xl bg-gradient-to-r from-brand-50 via-rose-50 to-amber-50 border border-brand-100 p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-brand-700 uppercase tracking-wider">
          ✉️ 헬스픽 큐레이션 팀
        </div>
        <h2 class="mt-1 text-lg md:text-xl font-bold text-slate-900">
          다뤘으면 하는 주제가 있나요?
        </h2>
        <p class="mt-1 text-sm text-slate-600 leading-relaxed">
          헬스픽은 독자분들이 가장 궁금해하시는 주제를 우선해서 정리합니다.
          관심 주제·자료·경험담을 보내주시면 다음 큐레이션에 반영합니다.
        </p>
      </div>
      <a
        href="/tip/"
        class="shrink-0 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition"
      >
        주제 제안 보내기
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>

  <AdSlot label="광고" className="container-x" />

  {CATEGORY_ORDER.map((slug) => {
    const c = CATEGORIES[slug];
    const items = byCategory[slug];
    if (!items || items.length === 0) return null;
    return (
      <section class="container-x py-6">
        <div class="flex items-end justify-between mb-4">
          <h2 class="text-xl md:text-2xl font-bold text-slate-900">
            <span class="mr-1">{c.emoji}</span>{c.name}
          </h2>
          <a href={`/category/${slug}/`} class="text-sm text-brand-700 hover:underline">{c.name} 전체 보기 →</a>
        </div>
        <p class="text-sm text-slate-600 mb-4">{c.description}</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {items.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
    );
  })}
</BaseLayout>
